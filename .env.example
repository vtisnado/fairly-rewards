# NEAR testnet configuration (names only; fill values in .env, never commit it)
NEAR_NETWORK=testnet
NEXT_PUBLIC_NEAR_NETWORK=testnet
NEXT_PUBLIC_FAIRLY_CONTRACT=
NEXT_PUBLIC_TUSDC_CONTRACT=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Sponsor account that funds new customer accounts (server-side only)
SPONSOR_ACCOUNT_ID=
SPONSOR_PRIVATE_KEY=
SPONSOR_AMOUNT_NEAR=0.05

# Demo accounts used by the landing page "try as" buttons (testnet only)
DEMO_MERCHANT_ACCOUNT_ID=
DEMO_MERCHANT_PRIVATE_KEY=
DEMO_CASHIER_ACCOUNT_ID=
DEMO_CASHIER_PRIVATE_KEY=
