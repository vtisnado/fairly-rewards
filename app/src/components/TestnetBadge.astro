---
interface Props {
  demo?: boolean;
  demoLabel?: string;
}

const { demo = false, demoLabel = 'Demo account · sample data · test money' } = Astro.props;
---

{
  demo ? (
    <div class="flex h-7 items-center justify-center gap-2 bg-violet-700 text-xs font-semibold text-white" role="status" data-banner="demo">
      <span class="size-2 rounded-full bg-white"></span>
      {demoLabel}
    </div>
  ) : (
    <div class="flex h-7 items-center justify-center gap-2 bg-ink text-xs font-semibold text-cream" role="status" data-banner="testnet">
      <span class="size-2 rounded-full bg-sun"></span>
      NEAR testnet · test money only
    </div>
  )
}
