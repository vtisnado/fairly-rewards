---
export const prerender = true;

import '../styles/landing.css';
import BaseLayout from '../layouts/BaseLayout.astro';
import Coin from '../components/landing/Coin.astro';
import { ICONS } from '../lib/icons';
import { LANDING_CARD, MARQUEE_ITEMS, NAV_LINKS, NEAR_FEATURES, posterCells, uniqueCardArt } from '../lib/landing';

const heroCard = uniqueCardArt('hero', { ...LANDING_CARD, tierName: 'Silver', tierIndex: 1, stampsToNextTier: 5, stampsFilled: 2, balance: '12400000', number: '0042' });
const problemCard = uniqueCardArt('problem', { ...LANDING_CARD, tierName: 'Silver', tierIndex: 1, stampsToNextTier: 5, stampsFilled: 4, balance: '3750000', number: '0042' });
const resaleCard = uniqueCardArt('resale', { ...LANDING_CARD, tierName: 'Gold', tierIndex: 2, stampsToNextTier: 0, balance: '12400000', number: '0007' });
const poster = posterCells();

const siteUrl = (Astro.site ?? Astro.url).origin;
const siteDescription =
  'Fairly is a loyalty card that holds cashback, not points. Customers spend it at the counter or resell the card, and the shop earns a royalty. Runs on NEAR testnet with test money.';
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    '@id': `${siteUrl}/#organization`,
    name: 'Fairly',
    url: siteUrl,
    logo: `${siteUrl}/icon-512.png`,
    description: siteDescription,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    '@id': `${siteUrl}/#website`,
    name: 'Fairly',
    url: siteUrl,
    inLanguage: 'en',
    description: siteDescription,
    publisher: { '@id': `${siteUrl}/#organization` },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    '@id': `${siteUrl}/#app`,
    name: 'Fairly',
    url: siteUrl,
    applicationCategory: 'BusinessApplication',
    operatingSystem: 'Any',
    browserRequirements: 'Requires a modern web browser',
    description: siteDescription,
    image: `${siteUrl}/og.png`,
    publisher: { '@id': `${siteUrl}/#organization` },
  },
];

const products = [
  { src: 'coffee', cls: 'left-2 top-10 w-24', rotate: '-6deg', flip: false, delay: 0.7, float: 0 },
  { src: 'bag', cls: 'right-2 top-28 w-28', rotate: '8deg', flip: true, delay: 0.85, float: -2 },
  { src: 'croissant', cls: 'left-0 bottom-32 w-32', rotate: '-14deg', flip: true, delay: 1.0, float: -3 },
  { src: 'burger', cls: 'right-0 bottom-16 w-32', rotate: '6deg', flip: false, delay: 1.15, float: -1 },
  { src: 'gift', cls: 'right-6 top-2 w-16', rotate: '-12deg', flip: true, delay: 1.3, float: -4 },
  { src: 'donut', cls: 'left-6 top-[44%] w-20', rotate: '18deg', flip: false, delay: 1.4, float: -2.5 },
];

const recent = [
  { icon: 'cup', item: 'Flat white', price: '$4.50', cashback: '+$0.23' },
  { icon: 'cookie', item: 'Butter croissant', price: '$3.20', cashback: '+$0.16' },
  { icon: 'burger', item: 'Lunch bowl', price: '$12.00', cashback: '+$0.60' },
];

const dashboardBars = [40, 62, 35, 78, 90, 120, 104, 96, 112, 130];

const businessPoints = [
  { icon: 'star', color: 'text-sun', title: 'Your brand, your rules.', text: 'Colors, cashback, tiers with perks and seasonal boosts.' },
  { icon: 'tablet', color: 'text-lilac', title: 'Counter devices, no shared passwords.', text: 'Pair a tablet with a code. Daily cashback limits per location.' },
  { icon: 'chart', color: 'text-mint', title: 'See the sales loyalty brings.', text: 'A real-time dashboard with managers who can help run it.' },
];

const useLinks = [
  { href: '/demo', label: 'Demo' },
  { href: '/business/new', label: 'Start your business' },
  { href: '/market', label: 'Market' },
];

const realSteps = [
  { href: '/business/new', title: 'Register your business', text: 'Name, cashback and a starting pool, in a few minutes.', cta: 'Start your business' },
  { href: '', title: 'Connect your counter', text: 'Pair a phone or tablet from your dashboard with a short code.', cta: '' },
  { href: '', title: 'Your customers scan your QR and get your card', text: 'Every card holds cashback and can be resold for a royalty.', cta: '' },
];

const ctaPrimary =
  'btn-arrow flex h-16 items-center gap-4 rounded-xl bg-coral pl-7 pr-2 text-lg font-bold text-ink transition hover:-translate-y-0.5 hover:bg-[#f47661] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-sun';
const ctaGhost =
  'grid h-16 place-items-center rounded-xl border border-white/20 px-7 text-lg font-semibold transition hover:bg-white hover:text-ink focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-sun';
const arrowBox = 'arr grid size-12 place-items-center rounded-lg bg-ink text-coral';
const h2 = 'mt-3 text-5xl font-black leading-[.95] tracking-tight md:text-6xl';
const eyebrow = 'font-bold text-coral-dark';
---

<BaseLayout
  title="Loyalty cards with money inside"
  description={siteDescription}
  jsonLd={jsonLd}
>
  <div class="overflow-x-hidden">
    <header class="fixed inset-x-4 top-8 z-50">
      <div class="mx-auto flex h-16 max-w-6xl items-center justify-between rounded-2xl bg-white/95 pl-5 pr-2 shadow-soft">
        <a href="#top" class="flex items-center gap-2 text-2xl font-extrabold tracking-tight">
          <Coin id="nav" class="size-8" />
          <span class="logo-word">Fairly</span>
        </a>
        <nav aria-label="Main" class="hidden gap-8 font-semibold md:flex">
          {NAV_LINKS.map((link) => <a href={link.href} class="nav-link text-ink/70 hover:text-ink">{link.label}</a>)}
        </nav>
        <a href="/demo" class="btn-arrow flex h-12 items-center gap-3 rounded-xl bg-ink pl-5 pr-1.5 font-semibold text-white transition hover:bg-black hover:shadow-card">
          Try the demo
          <span class="arr grid size-9 place-items-center rounded-lg bg-coral text-ink">
            <svg viewBox="0 0 24 24" class="size-5" aria-hidden="true" set:html={ICONS.arrow} />
          </span>
        </a>
      </div>
    </header>

    <main>
      <section id="top" class="hero relative overflow-hidden bg-ink pb-28 pt-32 text-white md:pb-40 md:pt-44">
        <svg class="perf bottom-0" viewBox="0 0 1000 110" preserveAspectRatio="none" aria-hidden="true">
          <line x1="0" y1="104" x2="1000" y2="2" stroke="#FFF6EC" stroke-opacity=".18" stroke-width="2" stroke-dasharray="2 10" vector-effect="non-scaling-stroke"></line>
        </svg>
        <div class="absolute inset-0 opacity-[.06]" style="background-image:radial-gradient(#fff 1px,transparent 1px);background-size:22px 22px"></div>
        <svg class="spin-slow absolute -left-40 -top-40 size-[520px] text-white/[.05]" viewBox="0 0 100 100" aria-hidden="true">
          <circle cx="50" cy="50" r="46" fill="none" stroke="currentColor" stroke-width="7" stroke-dasharray="3 5"></circle>
        </svg>
        <div class="relative mx-auto grid max-w-6xl items-center gap-10 px-6 lg:grid-cols-[1.05fr_.95fr]">
          <div>
            <h1 class="animate-enter text-6xl font-black leading-[.92] tracking-tight md:text-[84px]" style="animation-delay:.1s">
              Loyalty that pays <span class="highlight text-sun">real money<svg viewBox="0 0 200 20" preserveAspectRatio="none" aria-hidden="true"><path d="M3 14 C 50 4, 120 4, 197 12" stroke="#F2654F" stroke-width="7" fill="none" stroke-linecap="round"></path></svg></span> back.
            </h1>
            <p class="animate-enter mt-7 max-w-lg text-xl text-white/75" style="animation-delay:.3s">
              A members card that holds cashback, not points. Your regulars spend it at your counter or pass the card on, and you earn on every resale.
            </p>
            <div class="animate-enter mt-10 flex flex-wrap gap-3" style="animation-delay:.45s">
              <a href="/demo" class={ctaPrimary}>
                Try the 5-minute demo
                <span class={arrowBox}><svg viewBox="0 0 24 24" class="size-6" aria-hidden="true" set:html={ICONS.arrow} /></span>
              </a>
              <a href="/business/new" class={ctaGhost}>Start your business</a>
            </div>
            <p class="animate-enter mt-5 font-mono text-sm text-white/60" style="animation-delay:.6s">NEAR testnet, test money only.</p>
          </div>

          <div class="relative mx-auto h-[640px] w-full max-w-[420px] lg:max-w-none">
            {products.map((product) => (
              <div class={`pop-in absolute ${product.cls}`} style={`animation-delay:${product.delay}s`}>
                <div class="float" style={`animation-delay:${product.float}s`}>
                  <img
                    src={`/img/${product.src}.webp`}
                    alt=""
                    width="320"
                    height="320"
                    class="h-auto w-full select-none drop-shadow-[0_18px_22px_rgba(0,0,0,.5)]"
                    style={`transform:rotate(${product.rotate})${product.flip ? ' scaleX(-1)' : ''}`}
                    draggable="false"
                  />
                </div>
              </div>
            ))}
            <div class="pop-in absolute left-20 top-[62%] z-20" style="animation-delay:1.5s"><div class="float" style="animation-delay:-2.5s"><Coin id="h1" class="size-12" delay={0.5} /></div></div>
            <div class="pop-in absolute right-14 top-[52%] z-20" style="animation-delay:1.6s"><div class="float" style="animation-delay:-1.5s"><Coin id="h2" class="size-9" delay={2} /></div></div>

            <div class="absolute left-1/2 top-0 z-10 -translate-x-1/2">
              <div class="animate-enter h-[600px] w-[292px] rounded-[46px] border-2 border-white/30 bg-[#0d0c10] p-2.5 shadow-[0_0_0_6px_rgba(255,255,255,.08),0_0_90px_rgba(242,101,79,.4),0_30px_60px_rgba(0,0,0,.55)]" style="animation-delay:.5s">
                <div class="relative flex size-full flex-col overflow-hidden rounded-[34px] bg-cream text-ink [clip-path:inset(0_round_34px)]">
                  <span class="absolute left-1/2 top-2.5 z-30 h-7 w-24 -translate-x-1/2 rounded-full bg-black"></span>
                  <div class="toast-loop absolute inset-x-3 top-11 z-20 flex items-center gap-3 rounded-xl bg-ink p-3 text-white shadow-card" aria-hidden="true">
                    <span class="grid size-9 place-items-center rounded-lg bg-coral text-ink"><svg viewBox="0 0 24 24" class="size-5" set:html={ICONS.cup} /></span>
                    <div class="min-w-0 flex-1">
                      <p class="truncate text-sm font-semibold">Flat white</p>
                      <p class="text-xs text-white/70">Paid $4.50 at Cafe Esquina</p>
                    </div>
                    <span class="text-sm font-bold text-sun">+$0.23</span>
                  </div>
                  <div class="px-4 pt-12">
                    <p class="text-xs text-ink/60">Cafe Esquina members</p>
                    <p class="text-lg font-bold">Hi, Maria</p>
                    <div class="mt-3 [&_svg]:h-auto [&_svg]:w-full" set:html={heroCard} />
                    <div class="mt-3 flex items-center gap-3">
                      <div class="h-2 flex-1 overflow-hidden rounded-full bg-ink/10"><div class="h-full w-2/5 rounded-full bg-gold"></div></div>
                      <span class="text-xs font-semibold text-ink/70">3 to Gold</span>
                    </div>
                  </div>
                  <div class="mt-4 flex-1 overflow-hidden px-4">
                    <p class="text-xs font-semibold text-ink/60">Recent</p>
                    <ul class="mt-2 space-y-2">
                      {recent.map((row) => (
                        <li class="flex items-center gap-2.5 rounded-xl bg-white p-2.5 shadow-soft">
                          <span class="grid size-8 place-items-center rounded-lg bg-coral-soft text-coral-dark"><svg viewBox="0 0 24 24" class="size-4" aria-hidden="true" set:html={ICONS[row.icon as keyof typeof ICONS]} /></span>
                          <div class="min-w-0 flex-1">
                            <p class="truncate text-[13px] font-semibold leading-tight">{row.item}</p>
                            <p class="text-[11px] text-ink/60">{row.price}</p>
                          </div>
                          <span class="rounded-md bg-sun-soft px-2 py-1 text-xs font-bold">{row.cashback}</span>
                        </li>
                      ))}
                    </ul>
                  </div>
                  <div class="grid h-14 grid-cols-5 items-center border-t border-ink/5 bg-white text-ink/40" aria-hidden="true">
                    <span class="grid place-items-center text-ink"><svg viewBox="0 0 24 24" class="size-5" set:html={ICONS.home} /></span>
                    <span class="grid place-items-center"><svg viewBox="0 0 24 24" class="size-5" set:html={ICONS.star} /></span>
                    <span class="grid place-items-center"><span class="-mt-6 grid size-11 place-items-center rounded-xl bg-coral text-ink shadow-card"><svg viewBox="0 0 24 24" class="size-5" set:html={ICONS.qr} /></span></span>
                    <span class="grid place-items-center"><svg viewBox="0 0 24 24" class="size-5" set:html={ICONS.list} /></span>
                    <span class="grid place-items-center"><svg viewBox="0 0 24 24" class="size-5" set:html={ICONS.tag} /></span>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <div class="marquee-band relative z-10 overflow-hidden py-8 md:py-20" aria-label="Businesses that use loyalty cards">
        <div class="marquee-tilt">
          <div class="marquee-track gap-3">
            {[0, 1].map((copy) => (
              <ul class="flex gap-3 pr-3" aria-hidden={copy === 1 ? 'true' : undefined}>
                {MARQUEE_ITEMS.map((item) => (
                  <li class="flex h-16 cursor-default items-center gap-3 whitespace-nowrap rounded-xl border border-ink/10 bg-white/60 px-6 text-lg font-semibold text-ink/75 transition hover:-translate-y-0.5 hover:border-coral hover:bg-coral hover:text-ink">
                    <svg viewBox="0 0 24 24" class="size-7" aria-hidden="true" set:html={ICONS[item.icon]} />
                    {item.label}
                  </li>
                ))}
              </ul>
            ))}
          </div>
        </div>
      </div>

      <section id="problem" class="mx-auto grid max-w-6xl items-center gap-16 px-6 py-10 md:py-20 lg:grid-cols-2">
        <div class="relative h-[380px]" role="img" aria-label="A paper stamp card fading away next to a digital loyalty card that holds $3.75">
          <svg class="paper-card absolute left-4 top-6 w-[360px] max-w-[85%]" viewBox="0 0 360 220" aria-hidden="true">
            <rect x="4" y="4" width="352" height="212" rx="10" fill="#FBF1E1" stroke="#E7D8BF" stroke-width="2"></rect>
            <text x="28" y="48" font-family="Outfit" font-weight="800" font-size="22" fill="#9C8A70">COFFEE CARD</text>
            <text x="28" y="72" font-family="Outfit" font-size="13" fill="#9C8A70">Buy 10, get 1 free</text>
            <g fill="none" stroke="#D6C4A6" stroke-width="2">
              {[50, 102, 154, 206, 258].flatMap((cx) => [120, 172].map((cy) => <circle cx={cx} cy={cy} r="18"></circle>))}
            </g>
            <g fill="#C47A5A" opacity=".55"><circle cx="50" cy="120" r="12"></circle><circle cx="102" cy="120" r="12"></circle><circle cx="154" cy="120" r="12"></circle></g>
          </svg>
          <div class="new-card absolute bottom-0 right-0 w-[360px] max-w-[85%] [&_svg]:h-auto [&_svg]:w-full" set:html={problemCard} />
        </div>
        <div class="reveal">
          <p class={eyebrow}>The problem</p>
          <h2 class={h2}>Stamp cards get lost. Points expire.</h2>
          <p class="mt-5 text-xl text-ink/70">Most rewards are never used and are worth nothing outside the shop. Small businesses pay for programs their customers forget.</p>
          <div class="mt-8 grid grid-cols-2 gap-3">
            <div class="rounded-xl3 border border-ink/5 bg-white p-5"><p class="text-4xl font-extrabold">$0.00</p><p class="font-semibold text-ink/65">cash inside a paper card</p></div>
            <div class="rounded-xl3 bg-ink p-5 text-white"><p class="text-4xl font-extrabold text-sun">$3.75</p><p class="font-semibold text-white/70">inside Maria's card today</p></div>
          </div>
        </div>
      </section>

      <section id="how" class="mx-auto max-w-6xl px-6 py-16">
        <div class="reveal mx-auto max-w-2xl text-center">
          <p class={eyebrow}>How it works</p>
          <h2 class={h2}>Three moments. No app to install.</h2>
        </div>
        <ol class="mt-14 grid gap-5 md:grid-cols-3">
          <li class="reveal group flex min-h-[440px] flex-col rounded-xl3 border border-ink/5 bg-coral-soft p-8 transition hover:-translate-y-1 hover:shadow-card">
            <div class="flex items-center gap-3"><span class="grid size-11 place-items-center rounded-full bg-ink text-lg font-bold text-white">1</span><span class="font-semibold text-ink/65">At the counter</span></div>
            <div class="relative mt-6 h-48" aria-hidden="true">
              <svg viewBox="0 0 21 21" class="absolute left-1/2 top-2 size-40 -translate-x-1/2 -rotate-[5deg] rounded-2xl bg-white p-3 shadow-card" shape-rendering="crispEdges">
                {poster.map((cell) => <rect x={cell.x} y={cell.y} width="1" height="1" fill="#17161a"></rect>)}
                {[[0, 0], [14, 0], [0, 14]].map(([x, y]) => (
                  <g transform={`translate(${x} ${y})`}>
                    <rect width="7" height="7" fill="#17161a"></rect><rect x="1" y="1" width="5" height="5" fill="#fff"></rect><rect x="2" y="2" width="3" height="3" fill="#17161a"></rect>
                  </g>
                ))}
              </svg>
            </div>
            <h3 class="mt-auto text-3xl font-extrabold">Scan, get a card</h3>
            <p class="mt-2 text-lg text-ink/75">The poster at the counter opens the card in the browser.</p>
          </li>
          <li class="reveal group flex min-h-[440px] flex-col rounded-xl3 border border-ink/5 bg-sun-soft p-8 transition hover:-translate-y-1 hover:shadow-card" style="animation-delay:.1s">
            <div class="flex items-center gap-3"><span class="grid size-11 place-items-center rounded-full bg-ink text-lg font-bold text-white">2</span><span class="font-semibold text-ink/65">Every visit</span></div>
            <div class="relative mt-6 h-48" aria-hidden="true">
              <div class="absolute inset-x-0 top-10 text-center text-7xl font-black tracking-tight">+$0.25</div>
              <span class="float absolute left-2 top-0"><Coin id="s1" class="size-12" delay={1} /></span>
              <span class="float absolute bottom-0 right-4" style="animation-delay:-2s"><Coin id="s2" class="size-9" delay={3} /></span>
            </div>
            <h3 class="mt-auto text-3xl font-extrabold">Each purchase pays back</h3>
            <p class="mt-2 text-lg text-ink/75">The cashier types the total. The cashback lands on the card as tUSDC, and tiers unlock perks.</p>
          </li>
          <li class="reveal group flex min-h-[440px] flex-col rounded-xl3 border border-ink/5 bg-lilac-soft p-8 transition hover:-translate-y-1 hover:shadow-card" style="animation-delay:.2s">
            <div class="flex items-center gap-3"><span class="grid size-11 place-items-center rounded-full bg-ink text-lg font-bold text-white">3</span><span class="font-semibold text-ink/65">Anytime</span></div>
            <div class="relative mt-6 h-48">
              <div class="absolute left-0 right-10 top-0 -rotate-6 [&_svg]:h-auto [&_svg]:w-full" aria-hidden="true" set:html={resaleCard} />
              <a href="/market" class="btn-arrow absolute -bottom-2 right-0 flex h-11 items-center gap-2 rounded-lg bg-ink px-4 text-sm font-bold text-white shadow-card transition hover:bg-black">
                Browse the market
                <span class="arr"><svg viewBox="0 0 24 24" class="size-4" aria-hidden="true" set:html={ICONS.arrow} /></span>
              </a>
            </div>
            <h3 class="mt-auto text-3xl font-extrabold">Spend it or pass it on</h3>
            <p class="mt-2 text-lg text-ink/75">Spend the balance with a code at the counter, or resell the card. The value stays inside it.</p>
          </li>
        </ol>
      </section>

      <section id="who" class="mx-auto max-w-6xl px-6 py-20">
        <div class="reveal flex flex-col justify-between gap-6 md:flex-row md:items-end">
          <div>
            <p class={eyebrow}>Who uses it</p>
            <h2 class={h2}>One platform, three roles</h2>
          </div>
          <p class="max-w-md text-xl text-ink/70">The business, the counter and the customer each get their own simple screen. Codes and money move between them in five steps.</p>
        </div>
      </section>
      <div class="reveal-zoom mx-auto -mt-6 max-w-[1400px] px-2">
        <picture>
          <source media="(max-width: 767px)" srcset="/roles-vertical.svg" width="420" height="1730" />
          <img src="/roles.svg" alt="Illustration of the business, the counter tablet, the customer and a buyer, with five numbered steps showing how codes and money move between them" width="1240" height="720" class="h-auto w-full" loading="lazy" />
        </picture>
      </div>

      <section id="business" class="py-20">
        <div class="mx-auto max-w-6xl px-6">
          <div class="grid items-center gap-14 overflow-hidden rounded-[28px] bg-ink p-10 text-white md:p-16 lg:grid-cols-2">
            <div class="reveal-left">
              <p class="font-bold text-coral">For businesses</p>
              <h2 class={h2}>Launch your loyalty program in minutes</h2>
              <ul class="mt-8 space-y-5 text-lg">
                {businessPoints.map((point) => (
                  <li class="flex gap-4">
                    <span class={`grid size-10 shrink-0 place-items-center rounded-lg bg-white/10 ${point.color}`}><svg viewBox="0 0 24 24" class="size-5" aria-hidden="true" set:html={ICONS[point.icon as keyof typeof ICONS]} /></span>
                    <span><b>{point.title}</b> <span class="text-white/70">{point.text}</span></span>
                  </li>
                ))}
              </ul>
              <div class="mt-10 flex flex-wrap gap-3">
                <a href="/business/new" class={ctaPrimary}>
                  Start your business
                  <span class={arrowBox}><svg viewBox="0 0 24 24" class="size-6" aria-hidden="true" set:html={ICONS.arrow} /></span>
                </a>
                <a href="/demo" class={ctaGhost}>Try the 5-minute demo</a>
              </div>
            </div>
            <div class="reveal-right">
              <div class="rounded-xl3 bg-white p-6 text-ink shadow-card" role="img" aria-label="Example dashboard with sales from members, cashback paid, purchases and a bar chart of recent days">
                <div class="flex items-center justify-between"><p class="font-bold">Cafe Esquina · Last 30 days</p><span class="rounded-md bg-bo-bg px-2 py-0.5 text-xs font-semibold text-bo-muted">Example data</span></div>
                <p class="mt-4 text-sm text-ink/65">Sales from members</p>
                <p class="text-5xl font-extrabold tracking-tight">$4,820</p>
                <div class="mt-5 grid grid-cols-3 gap-2 text-sm">
                  <div class="rounded-lg bg-bo-bg p-3"><p class="text-ink/65">Cashback paid</p><p class="text-xl font-bold">$241</p></div>
                  <div class="rounded-lg bg-bo-bg p-3"><p class="text-ink/65">Purchases</p><p class="text-xl font-bold">612</p></div>
                  <div class="rounded-lg bg-bo-bg p-3"><p class="text-ink/65">Cards</p><p class="text-xl font-bold">148</p></div>
                </div>
                <div class="mt-5 flex h-36 items-end gap-2" aria-hidden="true">
                  {dashboardBars.map((height, index) => <div class={`bar flex-1 rounded-md ${index === dashboardBars.length - 1 ? 'bg-coral' : 'bg-coral-soft'}`} style={`--h:${height}px`}></div>)}
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <section id="real" class="mx-auto max-w-6xl px-6 py-20">
        <div class="reveal max-w-2xl">
          <p class={eyebrow}>For real, on testnet</p>
          <h2 class={h2}>Use it for real (testnet)</h2>
          <p class="mt-5 text-xl text-ink/70">Your own business, your own card, test money only.</p>
        </div>
        <ol class="mt-12 grid gap-4 md:grid-cols-3">
          {realSteps.map((step, index) => (
            <li class="reveal rounded-xl3 border border-ink/5 bg-white p-6" style={`animation-delay:${index * 0.08}s`}>
              <span class="grid size-12 place-items-center rounded-xl bg-ink text-2xl font-black text-coral">{index + 1}</span>
              <h3 class="mt-6 text-2xl font-extrabold">{step.title}</h3>
              <p class="mt-2 text-ink/70">{step.text}</p>
              {step.href && <a href={step.href} class="mt-5 inline-flex h-11 items-center rounded-lg bg-ink px-5 font-bold text-white transition hover:bg-black">{step.cta}</a>}
            </li>
          ))}
        </ol>
      </section>

      <section id="near" class="mx-auto max-w-6xl px-6 py-20">
        <div class="reveal max-w-2xl">
          <p class={eyebrow}>Under the hood</p>
          <h2 class={h2}>Customers see a card. NEAR does the rest.</h2>
          <p class="mt-5 text-xl text-ink/70">No wallet to install and no fees to pay. Four things run on NEAR testnet behind it.</p>
        </div>
        <ul class="mt-12 grid gap-4 md:grid-cols-2 lg:grid-cols-4">
          {NEAR_FEATURES.map((feature, index) => (
            <li class="reveal rounded-xl3 border border-ink/5 bg-white p-6 transition hover:-translate-y-1 hover:shadow-card" style={`animation-delay:${index * 0.08}s`}>
              <span class="grid size-12 place-items-center rounded-xl bg-ink" style={`color:${feature.color}`}><svg viewBox="0 0 24 24" class="size-6" aria-hidden="true" set:html={ICONS[feature.icon]} /></span>
              <h3 class="mt-6 text-2xl font-extrabold">{feature.title}</h3>
              <p class="mt-2 text-ink/70">{feature.text}</p>
            </li>
          ))}
        </ul>
      </section>
    </main>

    <footer class="footer-slant relative mt-10 overflow-hidden bg-ink pb-10 pt-32 text-white md:pt-48">
      <svg class="perf top-0" viewBox="0 0 1000 110" preserveAspectRatio="none" aria-hidden="true">
        <line x1="0" y1="118" x2="1000" y2="8" stroke="#FFF6EC" stroke-opacity=".18" stroke-width="2" stroke-dasharray="2 10" vector-effect="non-scaling-stroke"></line>
      </svg>
      <svg class="spin-slow absolute -bottom-40 -right-40 size-[520px] text-white/[.05]" viewBox="0 0 100 100" aria-hidden="true">
        <circle cx="50" cy="50" r="46" fill="none" stroke="currentColor" stroke-width="7" stroke-dasharray="3 5"></circle>
      </svg>
      <div class="relative mx-auto max-w-6xl px-6">
        <div class="grid items-end gap-12 lg:grid-cols-[1.3fr_1fr]">
          <div>
            <h2 class="text-5xl font-black leading-[.92] tracking-tight md:text-7xl">Try every side of it in your browser</h2>
            <div class="mt-10 flex flex-wrap gap-3">
              {useLinks.map((link, index) =>
                index === 0 ? (
                  <a href={link.href} class={ctaPrimary}>
                    {link.label}
                    <span class={arrowBox}><svg viewBox="0 0 24 24" class="size-6" aria-hidden="true" set:html={ICONS.arrow} /></span>
                  </a>
                ) : (
                  <a href={link.href} class={ctaGhost}>{link.label}</a>
                ),
              )}
            </div>
            <p class="mt-5 font-mono text-sm text-white/70">NEAR testnet, test money only.</p>
          </div>
          <div class="relative hidden h-56 lg:block" aria-hidden="true">
            <div class="absolute right-24 top-0 w-36 rotate-[10deg]"><div class="float"><img src="/img/coffee.webp" alt="" width="320" height="320" class="h-auto w-full drop-shadow-[0_22px_26px_rgba(0,0,0,.45)]" loading="lazy" /></div></div>
            <div class="absolute bottom-0 right-0 w-36"><div class="float" style="animation-delay:-2s"><img src="/img/donut.webp" alt="" width="320" height="320" class="h-auto w-full drop-shadow-[0_22px_26px_rgba(0,0,0,.45)]" loading="lazy" /></div></div>
            <div class="float absolute left-10 top-10" style="animation-delay:-1s"><Coin id="f1" class="size-16" delay={1.5} /></div>
          </div>
        </div>
        <div class="mt-20 grid gap-8 border-t border-white/10 pt-8 text-sm md:grid-cols-4">
          <div>
            <a href="#top" class="flex items-center gap-2 text-2xl font-extrabold tracking-tight"><Coin id="f2" class="size-8" />Fairly</a>
            <p class="mt-3 text-white/70">Loyalty cards with money inside, for small businesses.</p>
          </div>
          <nav aria-label="Product">
            <p class="font-bold">Product</p>
            <ul class="mt-3 space-y-2 text-white/70">
              <li><a class="transition hover:text-white" href="#how">How it works</a></li>
              <li><a class="transition hover:text-white" href="#who">Who uses it</a></li>
            </ul>
          </nav>
          <nav aria-label="Use it">
            <p class="font-bold">Try Fairly</p>
            <ul class="mt-3 space-y-2 text-white/70">
              {useLinks.map((link) => <li><a class="transition hover:text-white" href={link.href}>{link.label}</a></li>)}
            </ul>
          </nav>
          <div>
            <p class="font-bold">Open source</p>
            <ul class="mt-3 space-y-2 text-white/70">
              <li>MIT license</li>
              <li><a class="transition hover:text-white" href="#near">Under the hood</a></li>
            </ul>
          </div>
        </div>
      </div>
    </footer>
  </div>
</BaseLayout>
