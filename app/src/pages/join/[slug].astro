---
import BaseLayout from '../../layouts/BaseLayout.astro';
import JoinApp from '../../components/wallet/JoinApp.vue';
import { getProgram } from '../../lib/near';
import { manifestUrl } from '../../lib/manifest';

let program = null;
if (Astro.params.slug) {
  try {
    program = await getProgram(Astro.params.slug);
  } catch {
    return new Response('The network is busy. Try again in a moment.', { status: 503, headers: { 'retry-after': '5' } });
  }
}
if (!program) {
  return Astro.redirect('/404');
}
---

<BaseLayout
  title={`${program.name} card`}
  description={`Join the ${program.name} rewards club.`}
  manifest={manifestUrl('wallet')}
  appTitle="Fairly"
>
  <JoinApp client:only="vue" program={program} />
</BaseLayout>
